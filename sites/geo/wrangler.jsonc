{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // The geopolitics study notes (geo.wanngo.com): static files only.
  "name": "wanngo-geo",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "geo.wanngo.com", "custom_domain": true }],
  "workers_dev": false
}
