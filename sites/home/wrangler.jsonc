{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // The personal home page (wanngo.com, www): static files only.
  "name": "wanngo-home",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "wanngo.com", "custom_domain": true },
    { "pattern": "www.wanngo.com", "custom_domain": true }
  ],
  "workers_dev": false
}
